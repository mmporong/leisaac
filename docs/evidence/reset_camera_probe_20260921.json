  "mechanism_from_source": {
    "isaaclab_reset": "envs/manager_based_env.py: reset() -> _reset_idx -> write_data_to_sim -> sim.forward -> (sim.render only if cfg.rerender_on_reset) -> record_post_reset -> obs_buf = observation_manager.compute()",
    "sensor_refresh": "sensors/sensor_base.py: reset() marks _is_outdated; .data -> _update_outdated_buffers reads the annotator's most recent render; update(dt) marks outdated only when timestamp - last_update >= cfg.update_period",
    "camera_update_period_s": 0.03333333333333333,
    "physics_step_s": 0.016666666666666666,
    "decimation": 1,
    "consequence": "The camera buffer refreshes every second control step (frames 2k and 2k+1 carry the same image), and after reset it holds the previous attempt's final render until two physics steps have passed.",
    "recorder": "envs/mdp/recorders/recorders.py PreStepFlatPolicyObservationsRecorder stores obs_buf['policy'] verbatim, so the stale image is what the HDF5 obs/front and obs/wrist frames 0 and 1 contain.",
    "generation_override_search": "scripts/mimic/generate_dataset.py, scripts/mimic/runtime_options.py and the task configs set no rerender_on_reset and no update_period override; replay/evaluation scripts set rerender_on_reset=True plus 4 warm-up renders, the generator does not."
  },
